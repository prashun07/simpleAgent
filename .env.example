# =============================================================================
# Enterprise Knowledge Assistant — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- Provider selection ---
# LLM: ollama | gemini | groq
LLM_PROVIDER=gemini

# Embeddings: ollama | gemini
EMBEDDING_PROVIDER=gemini

# --- Ollama (local open-source models) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Google Gemini (cloud, free tier) ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2

# --- Groq (cloud, hosts open-source Llama/Mixtral) ---
GROQ_API_KEY=your-groq-api-key-here
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# --- Knowledge base paths ---
DOCUMENTS_DIR=data/documents
CHROMA_DIR=chroma_db
CHROMA_COLLECTION=enterprise_knowledge

# --- RAG tuning ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4

# =============================================================================
# QUICK PRESETS (uncomment one block)
# =============================================================================

# PRESET 1: Fully local (100% open-source, private)
# LLM_PROVIDER=ollama
# EMBEDDING_PROVIDER=ollama

# PRESET 2: Local embeddings + Groq LLM (fast cloud inference)
# LLM_PROVIDER=groq
# EMBEDDING_PROVIDER=ollama

# PRESET 3: All cloud Gemini (easiest to start)
# LLM_PROVIDER=gemini
# EMBEDDING_PROVIDER=gemini
